{
  "name": "HomePage",
  "version": "1.0.0",
  "description": "Vanilla JS Webpack setup",
  "main": "index.js",
  "scripts": {
    "setup": "npm install gh-pages --save-dev && npm install",
    "build": "webpack --config webpack.prod.js",
    "dev": "webpack serve --config webpack.dev.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "git:save": "git add . && git commit -m \"feat: update app\"",
    "git:push": "git push origin main",
    "publish:app": "npm run git:save && npm run git:push && npm run deploy"
  },
  "type": "module",
  "devDependencies": {
    "css-loader": "^7.1.5",
    "gh-pages": "^6.3.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  }
}
